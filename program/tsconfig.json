{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "target/types/**/*.ts",
    "target/idl/**/*.json"
  ]
}
