{
  "name": "brume-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun next dev",
    "dev:multiplayer": "bun run multiplayer/server.ts",
    "dev:vinext": "vinext dev",
    "build": "bun --bun next build --webpack",
    "build:vinext": "vinext build",
    "start": "bun --bun next start",
    "start:vinext": "vinext start",
    "lint": "eslint",
    "test:multiplayer": "bun test multiplayer/server.test.ts",
    "test:multiplayer:browser": "bun run multiplayer/browser-smoke.ts",
    "test:chain": "cargo test --manifest-path program/Cargo.toml --workspace --all-targets",
    "test:chain:integration": "bun test program/tests/world-session.integration.test.ts --timeout 120000",
    "test:chain:session:devnet": "bun run program/scripts/verify-session-devnet.ts",
    "typecheck:chain": "bunx tsc --project program/tsconfig.json --noEmit",
    "build:chain": "cd program && anchor build",
    "dev:magicblock": "npx --yes --package @magicblock-labs/ephemeral-validator@0.14.10 mb-stack --reset --ledger program/test-ledger",
    "deploy:chain:local": "solana program deploy program/target/deploy/brume_world.so --program-id program/target/deploy/brume_world-keypair.json --url http://127.0.0.1:8899",
    "provision:magicblock:devnet": "bun run program/scripts/provision-devnet.ts",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json --experimental-warm-cdn-cache"
  },
  "dependencies": {
    "@magicblock-labs/gum-sdk": "3.0.10",
    "@neondatabase/serverless": "^1.1.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/web3.js": "^1.99.0",
    "@upstash/redis": "^1.38.3",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "standardwebhooks": "^1.1.1",
    "three": "0.182.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@coral-xyz/anchor": "0.32.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.17.3",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
