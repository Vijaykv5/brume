{
  "name": "my-bun-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun next dev",
    "dev:vinext": "vinext dev",
    "build": "bun --bun next build",
    "build:vinext": "vinext build",
    "start": "bun --bun next start",
    "start:vinext": "vinext start",
    "lint": "eslint",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json --experimental-warm-cdn-cache"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@upstash/redis": "^1.38.3",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "standardwebhooks": "^1.1.1",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
